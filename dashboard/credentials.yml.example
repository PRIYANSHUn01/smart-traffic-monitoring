# dashboard/credentials.yml.example
# ──────────────────────────────────
# Copy this file to credentials.yml and replace the hashed password.
#
# To generate a real bcrypt hash for your password, run:
#   python dashboard/generate_credentials.py
#
# SECURITY:
#   - DO NOT commit credentials.yml to git (.gitignore already excludes it)
#   - The cookie.key should be a long random secret — regenerate it for each deployment
#   - Hashes use bcrypt with cost factor 12 — they are safe to store

credentials:
  usernames:
    admin:
      email: admin@yourdomain.com
      name: Administrator
      # Replace with a real bcrypt hash — never store a plaintext password here.
      # Generate with: python dashboard/generate_credentials.py
      password: "$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH_HERE_xxxxxxxxxxxxxxxxxxxxxxx"

    officer:
      email: officer@yourdomain.com
      name: Traffic Officer
      password: "$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH_HERE_xxxxxxxxxxxxxxxxxxxxxxx"

cookie:
  expiry_days: 1          # session expires after 1 day of inactivity
  # Generate your own key: python -c "import secrets; print(secrets.token_hex(32))"
  key: "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"
  name: traffic_monitor_auth
