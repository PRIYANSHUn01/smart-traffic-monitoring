# .dockerignore — files excluded from Docker build context
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.env
.env.*
*.egg-info/
dist/
build/
.git/
.gitignore
*.md
tests/
.pytest_cache/
.mypy_cache/

# Large data files — mount as volumes instead
data/videos/
data/snapshots/
*.db
*.sqlite

# Model weights — download at runtime or mount as a volume.
# LOW-2 FIX: exclude root-level .pt files too (yolov8n.pt, yolov8s.pt).
# Use: docker run -v $(pwd)/models:/app/models ...
*.pt
models/*.pt

# Logs
logs/
*.log
