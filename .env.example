# .env — override config.py defaults without editing source code
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# ── Detection settings ────────────────────────────────────────
SKIP_FRAMES=2
CONFIDENCE_THRESHOLD=0.45
COUNT_LINE_POSITION=0.55

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── API Security (VUL-3 FIX) ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change_me_to_a_strong_random_secret

# ── CORS (VUL-2 FIX) ─────────────────────────────────────────
# Comma-separated list of trusted origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8501

# ── Email alerts (VUL-1 FIX) ─────────────────────────────────
ENABLE_EMAIL_ALERTS=false
EMAIL_SENDER=alerts@yourdomain.com
EMAIL_RECIPIENT=officer@dept.gov.in
# Use a Gmail App Password — NOT your account password.
# Generate at: myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=your_gmail_app_password_here
